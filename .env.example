# Backend (all optional - the app runs on public keyless APIs)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
ROUTING_PROVIDER=osrm            # osrm | synthetic
WEATHER_PROVIDER=open-meteo      # open-meteo | synthetic
GEOCODING_PROVIDER=nominatim
PLAN_THROTTLE_RATE=30/min
FORECAST_HORIZON_HOURS=48

# Frontend (frontend/.env.production)
VITE_API_BASE=https://your-service.onrender.com
